+            )}
+          >
+            {hasTitleLink && <div className={CARD_TITLE_CLASS}>{title}</div>}
+            {note && <NotePreview note={note} bookmarkId={bookmark.id} />}
+            {tagsVisible && (
+              <div
+                className={cn(
+                  "flex max-h-[3.25rem] shrink-0 flex-wrap gap-1 overflow-hidden",
+                  CARD_TAG_ROW_CLASS,
+                )}
