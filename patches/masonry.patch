+/**
+ * An image shown at its natural aspect ratio in the masonry layout. Its height
+ * is capped at twice the card width (the container is set up in
+ * `MasonryView`), cropping the bottom of very tall images.
+ */
+export function MasonryImage({ src, alt }: { src: string; alt: string }) {
+  const [loaded, setLoaded] = useState(false);
+  return (
+    <Image
+      alt={alt}
+      src={src}
+      width={0}
+      height={0}
+      unoptimized
+      sizes="100vw"
+      onLoad={() => setLoaded(true)}
+      className={cn(
+        "block h-auto max-h-[200cqw] w-full object-cover object-top",
+        // Reserve some space until the image's real size is known
+        !loaded && "aspect-[4/3] bg-muted",
+      )}
+    />
+  );
+}
+
+function MasonryImageActions({ bookmark }: { bookmark: ZBookmark }) {
+  const isBulkEditEnabled = useBulkActionsStore(
+    (state) => state.isBulkEditEnabled,
+  );
+  if (isBulkEditEnabled) return null;
+
+  return (
+    <div
+      className={cn(
+        "absolute bottom-2 right-2 z-[60] rounded bg-white/50 backdrop-blur-sm transition-opacity duration-200 dark:bg-black/50 [&>div]:text-foreground",
+        // Only shown on hover when there's a mouse (always visible on touch
+        // screens), and kept visible while the options menu is open.
+        "group-hover:opacity-100 has-[[data-state=open]]:opacity-100 [@media(pointer:fine)]:opacity-0",
+      )}
+    >
+      <BookmarkActionBar bookmark={bookmark} favouritedClassName="hidden" />
+    </div>
+  );
+}
+
+function MasonryView(props: Props) {
+  const { bookmark, image, title, className, wrapTags, bookmarkIndex } = props;
+  const { showNotes, showTags, showTitle } = useBookmarkDisplaySettings();
+  // The class name sizes placeholders that have no natural size of their own
+  const img = image("masonry", "aspect-[4/3] w-full");
+
+  if (!img) {
+    // Cards without an image (e.g. notes) keep the regular card look, sized
+    // to their content.
+    return (
+      <GridView {...props} layout="masonry" fitHeight image={() => null} />
+    );
+  }
+
+  const note = showNotes ? bookmark.note?.trim() : undefined;
+  const titleVisible = showTitle && !!title;
+  const tagsVisible =
+    showTags && (bookmark.tags.length > 0 || isBookmarkStillTagging(bookmark));
+
+  return (
+    <div
+      className={cn(
+        "group relative flex flex-col overflow-hidden rounded-lg",
+        className,
+      )}
+      data-bookmark-index={bookmarkIndex}
+    >
+      <BulkEditSelectionOverlay bookmark={bookmark} />
+      <OwnerIndicator bookmark={bookmark} />
+      <DragHandle bookmark={bookmark} className="left-2 top-2" />
+      <HoverActionBar bookmark={bookmark} />
+      <div className="relative w-full [container-type:inline-size]">
+        {img}
+        <MasonryImageActions bookmark={bookmark} />
+      </div>
+      {(titleVisible || note || tagsVisible) && (
+        <div className="flex flex-col gap-2 overflow-hidden p-2">
+          {titleVisible && (
+            <div className="line-clamp-2 overflow-hidden text-ellipsis break-words text-lg">
+              {title}
+            </div>
+          )}
+          {note && <NotePreview note={note} bookmarkId={bookmark.id} />}
+          {tagsVisible && (
+            <div className="flex flex-wrap gap-1 overflow-hidden">
+              <TagList
+                className={wrapTags ? undefined : "h-full"}
+                bookmark={bookmark}
+                loading={isBookmarkStillTagging(bookmark)}
+              />
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
