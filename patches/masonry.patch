+/**
+ * An image shown at its natural aspect ratio in the masonry layout. Its height
+ * is capped at twice the card width (the container is set up in
+ * `MasonryView`), cropping the bottom of very tall images.
+ */
+export function MasonryImage({
+  src,
+  alt,
+  onError,
+}: {
+  src: string;
+  alt: string;
+  onError?: () => void;
+}) {
+  const [loaded, setLoaded] = useState(false);
+  return (
+    <Image
+      alt={alt}
+      src={src}
+      width={0}
+      height={0}
+      unoptimized
+      sizes="100vw"
+      onLoad={() => setLoaded(true)}
+      onError={onError}
+      className={cn(
+        "block h-auto max-h-[200cqw] w-full object-cover object-top",
+        // Reserve some space until the image's real size is known
+        !loaded && "aspect-[4/3] bg-muted",
+      )}
+    />
+  );
+}
+
+/** The card's menu (and preview button), sitting on the image's bottom corner. */
+function MasonryImageActions({ bookmark }: { bookmark: ZBookmark }) {
+  const isBulkEditEnabled = useBulkActionsStore(
+    (state) => state.isBulkEditEnabled,
+  );
+  if (isBulkEditEnabled) return null;
+
+  return (
+    <div
+      className={cn(
+        "absolute bottom-1.5 right-1.5 z-[60] rounded-md transition-opacity duration-200",
+        TOOLBAR_TILE_CLASS,
+        // Only shown on hover when there's a mouse (always visible on touch
+        // screens), and kept visible while the options menu is open.
+        "group-focus-within:opacity-100 group-hover:opacity-100 has-[[data-state=open]]:opacity-100 [@media(pointer:fine)]:opacity-0",
+      )}
+    >
+      <BookmarkActionBar bookmark={bookmark} hideFavourite />
+    </div>
+  );
+}
+
+/**
+ * Pinterest-style cards: the image at its natural shape, with the title, note
