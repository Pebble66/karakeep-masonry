+    return <GridView layout="masonry" {...props} />;
+  }
+
+  const note = showNotes ? bookmark.note?.trim() : undefined;
+  const hasTitleLink = showTitle && !!title;
+  const isTagging = isBookmarkStillTagging(bookmark);
